# Konfiguracja Firebase (Realtime Database) — skopiuj do .env.local i uzupełnij.
# Skąd wziąć wartości: Firebase Console -> Project settings -> Your apps -> Web app -> config.
# VITE_FIREBASE_DATABASE_URL znajdziesz w zakładce Realtime Database (np. https://xxx-default-rtdb.europe-west1.firebasedatabase.app)
# Bez tych wartości aplikacja działa w TRYBIE LOKALNYM (synchronizacja tylko między kartami jednej przeglądarki).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
